# ============================================================================
# AI Brain Server Environment Configuration (.env)
# ============================================================================

# Server Port & Binding (0.0.0.0 required for preview proxy)
PORT=3000
HOST=0.0.0.0

# Database Configuration (PostgreSQL 15+ with pgvector)
# Leave empty to use high-performance built-in vector memory engine
DATABASE_URL=postgresql://aibrain:aibrain_secure_pass_2026@localhost:5432/aibrain_db
DATABASE_SSL=false

# Distributed Queue (Redis / BullMQ)
REDIS_URL=redis://localhost:6379

# LLM Providers (Claude API Primary, fallback built-in)
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Multilingual Embeddings (HuggingFace multilingual-e5 or OpenAI text-embedding-3)
# Leave empty to use high-accuracy local multilingual vector projection
EMBEDDING_API_KEY=
EMBEDDING_ENDPOINT=

# Web Search Provider (Brave Search or Tavily)
# Leave empty to use built-in search retriever
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=

# Security & Encryption (AES-256-GCM secret for GitHub tokens and user keys)
ENCRYPTION_SECRET=aibrain_master_encryption_key_2026_sinhala_english

# GitHub Integration (Optional: Default token for automated Actions & PRs)
GITHUB_TOKEN=ghp_...

# Continuous Internet Learning Interval (in minutes)
LEARNING_INTERVAL_MINUTES=60
